# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://reeseastor.com

# ---------------------------------------------------------------------------
# Sanity
# ---------------------------------------------------------------------------
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty to run the site in seed-content mode:
# pages render from data/catalog.seed.json + lib/content/golden-parachute.ts and
# no network call is made to Sanity. This is the "safe mock mode" used by CI.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# PostHog
# ---------------------------------------------------------------------------
# Without NEXT_PUBLIC_POSTHOG_KEY, analytics runs in no-op mode: events are
# validated and (in development) logged, but nothing leaves the browser/server.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=

# ---------------------------------------------------------------------------
# Kit (formerly ConvertKit) — API V4
# ---------------------------------------------------------------------------
# Without KIT_API_KEY, POST /api/newsletter validates the payload and returns a
# success state without contacting Kit (mock mode). It never silently drops a
# real subscriber when the key IS configured.
KIT_API_KEY=
KIT_API_BASE_URL=https://api.kit.com/v4
KIT_TAG_HUDSON_DYNASTY_ID=
KIT_TAG_GOLDEN_PARACHUTE_ID=
KIT_TAG_BONUS_MORNING_AFTER_ID=
KIT_TAG_SOURCE_META_ID=
KIT_TAG_SOURCE_TIKTOK_ID=
KIT_TAG_SOURCE_BOOKBUB_ID=
KIT_TAG_EXISTING_READER_ID=

# ---------------------------------------------------------------------------
# Amazon
# ---------------------------------------------------------------------------
AMAZON_DEFAULT_MARKETPLACE=https://www.amazon.com

# Golden Parachute is prelaunch. Until KDP publishes the title there is no ASIN,
# no product URL and no Amazon Attribution URL. Fill these in Sanity (preferred)
# or here; the publication guard keeps the purchase CTA hidden until they exist.
# GOLDEN_PARACHUTE_ASIN=
# GOLDEN_PARACHUTE_AMAZON_URL=

# ---------------------------------------------------------------------------
# Build / runtime flags
# ---------------------------------------------------------------------------
# Allow next/image to load m.media-amazon.com in a production build. Off by
# default: production must serve the Sanity-hosted cover asset.
ALLOW_AMAZON_IMAGE_HOST=false
